# Intranet YApi origin, no trailing slash.
YAPI_BASE_URL=http://yapi.internal.example.com

# Default project when tools omit projectId.
YAPI_PROJECT_ID=123

# Project token from YApi → 项目设置 → token.
# Single project:
YAPI_TOKEN=your_64_char_project_token
# Or multiple: 123:tokenA,456:tokenB
# YAPI_PROJECT_TOKENS=123:tokenA,456:tokenB

# Required for advanced mock plugin APIs (not on the project-token whitelist).
# Domain / LDAP login name is fine (DOMAIN\\user or sAMAccountName). Login tries
# /api/user/login_by_ldap first, then /api/user/login.
YAPI_EMAIL=you@example.com
YAPI_PASSWORD=your_password
# auto (default) | ldap | password
# YAPI_LOGIN=auto

# Optional: paste _yapi_token / _yapi_uid cookie string instead of password.
# YAPI_COOKIE=_yapi_token=...; _yapi_uid=...

# Self-signed intranet HTTPS
# YAPI_INSECURE_TLS=true

# Playground / HTTP MCP port
PORT=43181

# Team HTTP MCP access token. Clients send Authorization: Bearer <this>.
# Required when pointing at a real YApi. Generate with: openssl rand -hex 24
# MCP_HTTP_AUTH_TOKEN=replace-with-a-long-random-token

# Force in-process demo YApi (no intranet needed)
YAPI_DEMO=true
